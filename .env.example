# =============================================
# LOKEA - Configuration Environnement Backend
# =============================================

# Serveur
PORT=5000
NODE_ENV=development

# MongoDB (remplace par ta vraie URI MongoDB Atlas ou locale)
MONGODB_URI=mongodb://localhost:27017/lokea

# JWT Secret (change cette clé en production !)
JWT_SECRET=lokea_super_secret_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# Admin par défaut (sera créé au premier lancement)
ADMIN_EMAIL=admin@lokea.com
ADMIN_PASSWORD=Admin@Lokea2024

# Numéro WhatsApp (format international sans +)
WHATSAPP_NUMBER=242XXXXXXXXX

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:3000

# Limite upload fichiers (en MB)
MAX_FILE_SIZE=50
